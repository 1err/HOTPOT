# Optional non-secret settings. Copy to .env to customize.
# Store your API key with: bash scripts/hotpot.sh key
HOTPOT_PORT=8000
HOTPOT_OPENAI_MODEL=gpt-5.4
HOTPOT_OPENAI_REQUEST_LIMIT=100

# The helper sets UID/GID to your local user so private key/data files remain
# readable by the non-root container on macOS and Linux.
# For direct docker compose commands, set these to `id -u` and `id -g`.
# HOTPOT_UID=1000
# HOTPOT_GID=1000
